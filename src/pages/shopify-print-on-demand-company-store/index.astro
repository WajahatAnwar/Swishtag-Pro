---
const target = '/shopify-company-store/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="https://swishtag.com/shopify-company-store/" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Redirecting...</title>
    <script is:inline>location.replace('/shopify-company-store/' + location.search + location.hash);</script>
  </head>
  <body>
    <p>Redirecting to <a href="/shopify-company-store/">/shopify-company-store/</a></p>
  </body>
</html>
